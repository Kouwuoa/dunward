#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Must match the render target storage texture format (R16G16B16A16_SFLOAT)
layout(rgba16f, set = 0, binding = 0) uniform image2D image;
layout(push_constant) uniform PerDrawData {
    uint object_index;
    uint material_index;
    uint vertex_offset;
    float time_sec;
} per_draw;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(image);
    if (p.x >= sz.x || p.y >= sz.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(sz);

    // Moving circle center
    vec2 c = vec2(0.5) + 0.25 * vec2(cos(per_draw.time_sec), sin(per_draw.time_sec * 1.3));
    float d = distance(uv, c);

    // Only write inside circle; outside should remain clear color
    if (d < 0.12) {
        vec3 col = vec3(1.0, 0.8, 0.2) * (1.0 - smoothstep(0.0, 0.12, d));
        imageStore(image, p, vec4(col, 1.0));
    }
}